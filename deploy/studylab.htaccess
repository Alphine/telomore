# studylab.id  (Hostinger, LiteSpeed/Apache)
#   /            landing page (deploy/landing)
#   /telomore/   Telomere Evolution Lab -- static React build (Vite base /telomore/); API on Railway
#   /foci/       Foci Lab -- static site + PHP image proxy (has its own .htaccess)
Options -Indexes
RewriteEngine On

# folder URLs without the trailing slash
RewriteRule ^(telomore|foci)$ /$1/ [R=301,L]

# the Telomere app used to live at the root: keep old links working
RewriteRule ^(simulate|evolve|pareto|sensitivity|gxe|active-learning|compare|experiments|genome|guide|login|register|verify|forgot-password|reset-password|demo\.html)(/.*)?$ /telomore/$1$2 [R=301,L]

# never expose source-ish files
RewriteRule \.(py|sh|md|log|tmp|bat)$ - [F,L]

# The demo cache is static data, never an app route: a missing file must be a
# real 404 (the client reports "HTTP 404"), not index.html with status 200.
RewriteCond %{REQUEST_URI} ^/telomore/(demo-cache|assets)/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ - [R=404,L]

# React Router inside /telomore/: any path that is not a real file or folder
# gets the app shell, so /telomore/simulate etc. work on reload
RewriteCond %{REQUEST_URI} ^/telomore/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /telomore/index.html [L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  # hashed Vite bundles never change; HTML shells must always be fresh
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Vite bundles under /telomore/assets/ are content-hashed
  SetEnvIf Request_URI "^/telomore/assets/" HASHED_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET
  # demo cache: the index is the version manifest (always revalidate); every
  # scenario file is requested as <file>.json?v=<sha> (frontend/src/demo/cache.ts),
  # so a given URL never changes content
  SetEnvIf Request_URI "^/telomore/demo-cache/index\.json$" DEMO_INDEX
  SetEnvIf Request_URI "^/telomore/demo-cache/.+\.json$" DEMO_SCENARIO
  SetEnvIf Request_URI "^/telomore/demo-cache/index\.json$" !DEMO_SCENARIO
  Header set Cache-Control "public, max-age=31536000, immutable" env=DEMO_SCENARIO
  Header set Cache-Control "no-cache" env=DEMO_INDEX
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>
