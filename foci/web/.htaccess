# Foci Lab on Hostinger (LiteSpeed / Apache compatible)
Options -Indexes

RewriteEngine On
# (.txt is NOT blocked: data/downloads/README_DATA.txt must be downloadable)
RewriteRule \.(py|sh|md|log|tmp)$ - [F,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# The upload analyser page posts files only to the Telomere Lab API on Railway:
# lock down what it may load and where it may send data.
<IfModule mod_headers.c>
  <FilesMatch "^analyze\.html$">
    Header set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src https://telomore-production.up.railway.app; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
  </FilesMatch>
</IfModule>
